<div class="pounding-heart-container show-splash">
    <div class="growing-spinner">
        <svg class="spinner" viewBox="0 0 50 50">
            <circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="2" />
        </svg>
    </div>
    <img class="logo" src="./jfrog.svg">
</div>
