<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- ====================================================================
       pexninja — native Windows (MSVC) build.

       This is a thin Visual Studio wrapper around the same pexninja.cpp the
       CMake build compiles. It links the Pexip Pulse runtime from the in-repo
       Pexip.Pulse NuGet package (restored via packages.config / nuget.config)
       and the rest of the UI deps (ImGui docking, ImPlot, gl3w, ImGui-Addons,
       GLFW) from third_party/, which fetch-deps.ps1 stages at the same pinned
       versions the CMakeLists.txt uses.

       One-time setup before building:
           powershell -ExecutionPolicy Bypass -File .\fetch-deps.ps1
           nuget restore pexninja.sln
       ==================================================================== -->

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{62A831E9-F8D7-47E9-AE7E-05BC540B4366}</ProjectGuid>
    <RootNamespace>pexninja</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(Configuration)'=='Release'">true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <!-- NuGet (packages.config) ExtensionSettings: pulls in Pexip.Pulse.props,
       which adds build/native/include to the include path and pexpulse.lib to
       the link line. -->
  <ImportGroup Label="ExtensionSettings">
    <Import Project="packages\Pexip.Pulse.1.0.17855-main\build\Pexip.Pulse.props" Condition="Exists('packages\Pexip.Pulse.1.0.17855-main\build\Pexip.Pulse.props')" />
  </ImportGroup>

  <!-- Locations the project depends on. -->
  <PropertyGroup Label="DepDirs">
    <ThirdParty>$(MSBuildProjectDirectory)\third_party</ThirdParty>
    <ImguiDir>$(ThirdParty)\imgui</ImguiDir>
    <ImplotDir>$(ThirdParty)\implot</ImplotDir>
    <Gl3wDir>$(ThirdParty)\gl3w</Gl3wDir>
    <ImguiAddonsDir>$(ThirdParty)\imgui-addons</ImguiAddonsDir>
    <GlfwDir>$(ThirdParty)\glfw</GlfwDir>
    <!-- Pexip.Pulse package root (the props uses MSBuildThisPackagePath; we
         need the path too, for the native lib dir + the runtime-asset copy). -->
    <PulsePkgDir>$(MSBuildProjectDirectory)\packages\Pexip.Pulse.1.0.17855-main</PulsePkgDir>
    <PulseNativeDir>$(PulsePkgDir)\runtimes\win-x64\native</PulseNativeDir>
  </PropertyGroup>

  <PropertyGroup>
    <OutDir>$(MSBuildProjectDirectory)\build\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\build\obj\$(Configuration)\</IntDir>
    <TargetName>pexninja</TargetName>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <ExceptionHandling>Sync</ExceptionHandling>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalIncludeDirectories>$(MSBuildProjectDirectory);$(ImguiDir);$(ImguiDir)\backends;$(ImguiDir)\misc\cpp;$(ImplotDir);$(ImguiAddonsDir)\FileBrowser;$(Gl3wDir)\include;$(GlfwDir)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>HOST_WINDOWS;NOMINMAX;WIN32_LEAN_AND_MEAN;_CRT_SECURE_NO_WARNINGS;VERSION="0.2.0";%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- pexninja.cpp / the vendored ImGui-Addons trip a handful of benign
           MSVC warnings; silence the noisiest (mirrors the -Wno-* the
           CMakeLists.txt passes) so the build log stays useful. -->
      <DisableSpecificWarnings>4244;4267;4996;4305;4101;4189;4018;4456;4457;4459;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalLibraryDirectories>$(PulseNativeDir);$(GlfwDir)\lib-vc2022;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <!-- pexpulse.lib is added by Pexip.Pulse.props. glfw3.lib is the static
           prebuilt GLFW; opengl32/gdi32/… are the system libs GLFW + gl3w
           need; dwmapi is used by the DwmGetWindowAttribute call. -->
      <AdditionalDependencies>glfw3.lib;opengl32.lib;dwmapi.lib;gdi32.lib;user32.lib;shell32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <!-- Sources. -->
  <ItemGroup>
    <!-- pexninja itself -->
    <ClCompile Include="..\pexninja.cpp" />

    <!-- Dear ImGui core + GLFW/OpenGL3 backends + std::string helpers -->
    <ClCompile Include="$(ImguiDir)\imgui.cpp" />
    <ClCompile Include="$(ImguiDir)\imgui_draw.cpp" />
    <ClCompile Include="$(ImguiDir)\imgui_tables.cpp" />
    <ClCompile Include="$(ImguiDir)\imgui_widgets.cpp" />
    <ClCompile Include="$(ImguiDir)\imgui_demo.cpp" />
    <ClCompile Include="$(ImguiDir)\backends\imgui_impl_glfw.cpp" />
    <ClCompile Include="$(ImguiDir)\backends\imgui_impl_opengl3.cpp" />
    <ClCompile Include="$(ImguiDir)\misc\cpp\imgui_stdlib.cpp" />

    <!-- ImPlot -->
    <ClCompile Include="$(ImplotDir)\implot.cpp" />
    <ClCompile Include="$(ImplotDir)\implot_items.cpp" />
    <ClCompile Include="$(ImplotDir)\implot_demo.cpp" />

    <!-- ImGui-Addons file browser -->
    <ClCompile Include="$(ImguiAddonsDir)\FileBrowser\ImGuiFileBrowser.cpp" />

    <!-- gl3w (C) — the explicit GL function loader -->
    <ClCompile Include="$(Gl3wDir)\src\gl3w.c">
      <CompileAs>CompileAsC</CompileAs>
    </ClCompile>
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="..\ImGuiUtils.h" />
  </ItemGroup>

  <ItemGroup>
    <None Include="packages.config" />
    <None Include="nuget.config" />
    <None Include="fetch-deps.ps1" />
    <None Include="README.md" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <ImportGroup Label="ExtensionTargets" />

  <!-- Fail early with a helpful message if the NuGet package or third-party
       sources are missing, rather than with a wall of compiler errors. -->
  <Target Name="EnsureNuGetPackageBuildImports" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <ErrorText>The Pexip.Pulse NuGet package is missing. Run 'nuget restore pexninja.sln' (it restores from ..\..\..\sdk\windows via nuget.config). Missing file: {0}.</ErrorText>
    </PropertyGroup>
    <Error Condition="!Exists('packages\Pexip.Pulse.1.0.17855-main\build\Pexip.Pulse.props')" Text="$([System.String]::Format('$(ErrorText)', 'packages\Pexip.Pulse.1.0.17855-main\build\Pexip.Pulse.props'))" />
    <Error Condition="!Exists('$(ImguiDir)\imgui.cpp')" Text="Third-party sources are missing. Run 'powershell -ExecutionPolicy Bypass -File .\fetch-deps.ps1' first." />
    <Error Condition="!Exists('$(Gl3wDir)\src\gl3w.c')" Text="gl3w has not been generated. Run 'powershell -ExecutionPolicy Bypass -File .\fetch-deps.ps1' first." />
    <Error Condition="!Exists('$(GlfwDir)\lib-vc2022\glfw3.lib')" Text="GLFW prebuilt libs are missing. Run 'powershell -ExecutionPolicy Bypass -File .\fetch-deps.ps1' first." />
  </Target>

  <!-- Copy the Pulse runtime assets (pexpulse.dll & friends + the ONNX models
       under share\models\…) next to the produced pexninja.exe. The managed
       windows demo gets this for free from the .NET SDK; a native build has to
       do it explicitly. -->
  <Target Name="CopyPulseRuntime" AfterTargets="Build">
    <ItemGroup>
      <PulseDlls Include="$(PulseNativeDir)\*.dll" />
      <PulseModels Include="$(PulseNativeDir)\share\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PulseDlls)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PulseModels)" DestinationFolder="$(OutDir)share\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
