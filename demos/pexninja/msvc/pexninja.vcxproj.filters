<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Filter Include="pexninja">
      <UniqueIdentifier>{11111111-1111-1111-1111-111111111111}</UniqueIdentifier>
    </Filter>
    <Filter Include="third_party">
      <UniqueIdentifier>{22222222-2222-2222-2222-222222222222}</UniqueIdentifier>
    </Filter>
    <Filter Include="third_party\imgui">
      <UniqueIdentifier>{33333333-3333-3333-3333-333333333333}</UniqueIdentifier>
    </Filter>
    <Filter Include="third_party\implot">
      <UniqueIdentifier>{44444444-4444-4444-4444-444444444444}</UniqueIdentifier>
    </Filter>
    <Filter Include="third_party\imgui-addons">
      <UniqueIdentifier>{55555555-5555-5555-5555-555555555555}</UniqueIdentifier>
    </Filter>
    <Filter Include="third_party\gl3w">
      <UniqueIdentifier>{66666666-6666-6666-6666-666666666666}</UniqueIdentifier>
    </Filter>
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="..\pexninja.cpp">
      <Filter>pexninja</Filter>
    </ClCompile>
    <ClCompile Include="$(ImguiDir)\imgui.cpp" />
    <ClCompile Include="$(ImguiDir)\imgui_draw.cpp" />
    <ClCompile Include="$(ImguiDir)\imgui_tables.cpp" />
    <ClCompile Include="$(ImguiDir)\imgui_widgets.cpp" />
    <ClCompile Include="$(ImguiDir)\imgui_demo.cpp" />
    <ClCompile Include="$(ImguiDir)\backends\imgui_impl_glfw.cpp" />
    <ClCompile Include="$(ImguiDir)\backends\imgui_impl_opengl3.cpp" />
    <ClCompile Include="$(ImguiDir)\misc\cpp\imgui_stdlib.cpp" />
    <ClCompile Include="$(ImplotDir)\implot.cpp" />
    <ClCompile Include="$(ImplotDir)\implot_items.cpp" />
    <ClCompile Include="$(ImplotDir)\implot_demo.cpp" />
    <ClCompile Include="$(ImguiAddonsDir)\FileBrowser\ImGuiFileBrowser.cpp" />
    <ClCompile Include="$(Gl3wDir)\src\gl3w.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\ImGuiUtils.h">
      <Filter>pexninja</Filter>
    </ClInclude>
  </ItemGroup>
  <ItemGroup>
    <None Include="nuget.config" />
    <None Include="fetch-deps.ps1" />
    <None Include="README.md" />
    <None Include="packages.config" />
  </ItemGroup>
</Project>