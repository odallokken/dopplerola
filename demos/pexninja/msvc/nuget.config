<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- The Pexip.Pulse .nupkg that ships in this repo under sdk/windows.
         The path is relative to this nuget.config (demos/pexninja/msvc). -->
    <add key="local-pulse" value="..\..\..\sdk\windows" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Claim both sources explicitly. Without this, any user-/machine-level
       <packageSourceMapping> would silently exclude local-pulse and nuget.org,
       so Pexip.Pulse (and its transitive deps) would fail to restore. -->
  <packageSourceMapping>
    <packageSource key="local-pulse">
      <package pattern="Pexip.Pulse" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
