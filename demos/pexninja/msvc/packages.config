<?xml version="1.0" encoding="utf-8"?>
<packages>
  <!-- Native Pexip Pulse runtime: headers (build/native/include), the
       pexpulse.lib import library and the win-x64 runtime DLLs + ONNX models.
       Restored from ../../../sdk/windows via nuget.config. The +<hash> build
       metadata on the .nupkg file name is not part of the package identity,
       so the version here is just "1.0.17855-main". -->
  <package id="Pexip.Pulse" version="1.0.17855-main" targetFramework="native" />
</packages>
