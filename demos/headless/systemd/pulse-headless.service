# ---------------------------------------------------------------------------
# pulse-headless.service — start the Pulse room client at boot.
#
# Normally installed for you by ../install.sh. To do it by hand:
#
#   sudo install -m 644 pulse-headless.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pulse-headless
#
# See ../README.md for the full install walk-through.
# ---------------------------------------------------------------------------
[Unit]
Description=Pexip Pulse headless room client
Wants=network-online.target
After=network-online.target

[Service]
Type=simple

# The Pulse runtime aborts at startup without PEX_BASE_PATH, and its private
# sibling libraries (libpexlgpl, libonnxruntime.so.1, ...) are only found via
# the library path.
Environment=PEX_BASE_PATH=/opt/pexip
Environment=LD_LIBRARY_PATH=/opt/pexip/lib

# A system service has no login session, so nothing has given it a home to
# write to; the audio libraries underneath Pulse then log a stream of "Failed
# to create secure directory" errors. StateDirectory= creates
# /var/lib/pulse-headless owned by the service account, and HOME points at it.
StateDirectory=pulse-headless
Environment=HOME=/var/lib/pulse-headless

# Audio (microphone / speaker) needs a PipeWire daemon this service can reach.
# There is none in a system service by default, and the client says so once and
# then carries on sending video. If you do run PipeWire system-wide, point the
# client at its socket directory and audio is attached within 30 seconds:
#Environment=PIPEWIRE_RUNTIME_DIR=/run/pipewire
# See ../README.md ("Audio") for the details.

ExecStart=/usr/local/bin/pulse-headless --config /etc/pulse-headless.conf

# Runs as an unprivileged account; 'video' grants access to /dev/video*, and
# 'audio' to the sound devices. ../install.sh creates it; by hand it is:
#   sudo useradd --system --user-group --groups video,audio \
#                --shell /usr/sbin/nologin pulse
User=pulse
Group=pulse
SupplementaryGroups=video audio

# The client supervises the webcam and the call itself and never exits on its
# own, so a restart here only ever means "something went very wrong".
Restart=always
RestartSec=5

# Modest hardening. Note: do NOT add PrivateDevices=yes — it hides /dev/video*
# from the service and the webcam would never be found.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
